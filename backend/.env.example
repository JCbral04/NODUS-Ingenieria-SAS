# --- NODUS Backend | Variables de entorno ---
# Copiar a .env y ajustar valores

# Base de datos (local con docker compose)
DATABASE_URL="postgresql://nodus:nodus@localhost:5432/nodus"

# JWT — ¡generar uno fuerte en producción! (openssl rand -hex 32)
JWT_SECRET="dev-secret-cambiar-en-produccion"
JWT_EXPIRES_IN="1h"

# Puerto de la API
PORT=3001

# Entorno
NODE_ENV=development

# Almacenamiento documental (ruta local del MVP)
STORAGE_PATH="./storage"

# Seed — contraseña de los usuarios demo (solo desarrollo)
SEED_PASSWORD="Nodus2026*"
